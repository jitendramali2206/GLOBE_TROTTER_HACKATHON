      'popularity': '★★★★★',
      'description':
          'Beautiful beaches, nightlife and adventure activities.',
    },
    {
      'name': 'Mumbai',
      'country': 'India',
      'region': 'Maharashtra',
      'cost': 'Expensive',
      'popularity': '★★★★★',
      'description':
          'India’s financial capital with iconic attractions.',
    },
    {
      'name': 'Jaipur',
      'country': 'India',
      'region': 'Rajasthan',
      'cost': 'Moderate',
      'popularity': '★★★★★',
      'description':
          'The Pink City famous for forts and royal history.',
    },
    {
      'name': 'Delhi',
      'country': 'India',
      'region': 'Delhi',
      'cost': 'Moderate',
      'popularity': '★★★★★',
      'description':
          'A historic city with monuments, markets and food.',
    },
    {
      'name': 'Paris',
      'country': 'France',
      'region': 'Europe',
      'cost': 'Expensive',
      'popularity': '★★★★★',
      'description':
          'Famous for art, fashion, architecture and landmarks.',
    },
    {
      'name': 'Dubai',
      'country': 'UAE',
      'region': 'Middle East',
      'cost': 'Expensive',
      'popularity': '★★★★★',
      'description':
          'Modern attractions, shopping and luxury experiences.',
    },
    {
      'name': 'Tokyo',
      'country': 'Japan',
      'region': 'Asia',
      'cost': 'Expensive',
      'popularity': '★★★★★',
      'description':
          'A perfect mix of technology, culture and food.',
    },
  ];

  @override
  Widget build(BuildContext context) {
    final filteredCities =
        cities.where((city) {
      final matchesSearch =
          city['name']!
                  .toLowerCase()
                  .contains(
                    searchText.toLowerCase(),
                  ) ||
              city['country']!
                  .toLowerCase()
                  .contains(
                    searchText.toLowerCase(),
                  );

      final matchesCountry =
          selectedCountry == 'All' ||
              city['country'] ==
                  selectedCountry;

      return matchesSearch &&
          matchesCountry;
    }).toList();

    return Scaffold(
      appBar: AppBar(
        title: const Text('Search Cities'),
      ),

      body: Column(
        children: [
          Padding(
            padding:
                const EdgeInsets.all(18),

            child: Column(
              children: [
                TextField(
                  onChanged: (value) {
                    setState(() {
                      searchText = value;
                    });
                  },

                  decoration:
                      const InputDecoration(
                    hintText:
                        'Search city or country...',
                    prefixIcon:
                        Icon(Icons.search),
                  ),
                ),

                const SizedBox(height: 12),

                SingleChildScrollView(
                  scrollDirection:
                      Axis.horizontal,

                  child: Row(
                    children: [
                      _filterChip('All'),

                      _filterChip('India'),

                      _filterChip('France'),

                      _filterChip('UAE'),

                      _filterChip('Japan'),
                    ],
                  ),
                ),
              ],
            ),
          ),

          Expanded(
            child: filteredCities.isEmpty
                ? const Center(
                    child: Text(
                      'No cities found',
                    ),
                  )
                : ListView.builder(
                    padding:
                        const EdgeInsets.fromLTRB(
                      18,
                      0,
                      18,
                      20,
                    ),

                    itemCount:
                        filteredCities.length,

                    itemBuilder:
                        (context, index) {
                      final city =
                          filteredCities[index];

                      return _cityCard(city);
                    },
                  ),
          ),
        ],
      ),
    );
  }

  Widget _filterChip(String country) {
    final isSelected =
        selectedCountry == country;

    return Padding(
      padding:
          const EdgeInsets.only(right: 8),

      child: ChoiceChip(
        label: Text(country),

        selected: isSelected,

        onSelected: (_) {
          setState(() {
            selectedCountry = country;
          });
        },
      ),
    );
  }

  Widget _cityCard(
    Map<String, String> city,
  ) {
    return Card(
      margin:
          const EdgeInsets.only(bottom: 14),

      child: Padding(
        padding:
            const EdgeInsets.all(16),

        child: Column(
          crossAxisAlignment:
              CrossAxisAlignment.start,

          children: [
            Row(
              children: [
                Container(
                  padding:
                      const EdgeInsets.all(12),

                  decoration: BoxDecoration(
                    color: Colors.deepPurple
                        .withOpacity(0.1),
                    borderRadius:
                        BorderRadius.circular(15),
                  ),

                  child: const Icon(
                    Icons.location_city,
                    color: Colors.deepPurple,
                  ),
                ),

                const SizedBox(width: 12),

                Expanded(
                  child: Column(
                    crossAxisAlignment:
                        CrossAxisAlignment.start,

                    children: [
                      Text(
                        city['name']!,
                        style:
                            const TextStyle(
                          fontSize: 19,
                          fontWeight:
                              FontWeight.bold,
                        ),
                      ),

                      Text(
                        '${city['region']}, ${city['country']}',
                        style: TextStyle(
                          color: Colors
                              .grey.shade600,
                        ),
                      ),
                    ],
                  ),
                ),

                const Icon(
                  Icons.bookmark_border,
                  color: Colors.deepPurple,
                ),
              ],
            ),

            const SizedBox(height: 12),

            Text(
              city['description']!,
              style: TextStyle(
                color: Colors.grey.shade700,
              ),
            ),

            const SizedBox(height: 14),

            Row(
              children: [
                _cityInfo(
                  Icons.account_balance_wallet,
                  city['cost']!,
                ),

                const SizedBox(width: 16),

                Text(
                  city['popularity']!,
                  style: const TextStyle(
                    color: Colors.orange,
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _cityInfo(
    IconData icon,
    String text,
  ) {
    return Row(
      children: [
        Icon(
          icon,
          size: 17,
          color: Colors.deepPurple,
        ),

        const SizedBox(width: 5),

        Text(
          text,
          style: const TextStyle(
            fontSize: 13,
          ),
        ),
      ],
    );
  }
}

