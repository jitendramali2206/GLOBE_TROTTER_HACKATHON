  String selectedCountry = 'All';

  final List<Map<String, String>> cities = [
    {
      'name': 'Ahmedabad',
      'country': 'India',
      'region': 'Gujarat',
      'cost': 'Affordable',
      'popularity': '★★★★☆',
      'description':
