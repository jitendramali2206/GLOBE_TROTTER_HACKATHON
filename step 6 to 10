                  Color(0xFF9B6CC8),
                ],
              ),
              borderRadius: BorderRadius.circular(24),
            ),
            child: Column(
              crossAxisAlignment:
                  CrossAxisAlignment.start,
              children: [
                const Icon(
                  Icons.public,
                  color: Colors.white,
                  size: 40,
                ),

                const SizedBox(height: 16),

                Text(
                  trip.name,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 26,
                    fontWeight: FontWeight.bold,
                  ),
                ),

                const SizedBox(height: 6),

                Text(
                  trip.destination,
                  style: const TextStyle(
                    color: Colors.white70,
                    fontSize: 16,
                  ),
                ),

                const SizedBox(height: 16),

                Text(
                  trip.description,
                  style: const TextStyle(
                    color: Colors.white,
                  ),
                ),
              ],
            ),
          ),

          const SizedBox(height: 20),

          const Text(
            'Trip Summary',
            style: TextStyle(
              fontSize: 21,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 12),

          Row(
            children: [
              Expanded(
                child: _summaryCard(
                  Icons.route,
                  '${trip.stops.length}',
                  'Stops',
                ),
              ),

              const SizedBox(width: 10),

              Expanded(
                child: _summaryCard(
                  Icons.currency_rupee,
                  totalCost.toStringAsFixed(0),
                  'Estimated Cost',
                ),
              ),
            ],
          ),

          const SizedBox(height: 20),

          const Text(
            'Share Your Adventure',
            style: TextStyle(
              fontSize: 21,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 12),

          Card(
            child: Padding(
              padding: const EdgeInsets.all(18),
              child: Column(
                children: [
                  const Icon(
                    Icons.link,
                    size: 42,
                    color: Colors.deepPurple,
                  ),

                  const SizedBox(height: 12),

                  const Text(
                    'Your trip is ready to share!',
                    style: TextStyle(
                      fontWeight: FontWeight.bold,
                      fontSize: 17,
                    ),
                  ),

                  const SizedBox(height: 8),

                  Text(
                    'Share this itinerary with your friends and travel partners.',
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      color: Colors.grey.shade600,
                    ),
