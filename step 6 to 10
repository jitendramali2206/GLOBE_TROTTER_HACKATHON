                      '$totalStops',
                      'Total Stops',
                    ),
                  ),
                ],
              ),

              const SizedBox(height: 10),

              Row(
                children: [
                  Expanded(
                    child: _dashboardCard(
                      Icons.account_balance_wallet,
                      '₹${totalBudget.toStringAsFixed(0)}',
                      'Total Budget',
                    ),
                  ),

                  const SizedBox(width: 10),

                  Expanded(
                    child: _dashboardCard(
                      Icons.payments,
                      '₹${totalEstimatedCost.toStringAsFixed(0)}',
                      'Planned Cost',
